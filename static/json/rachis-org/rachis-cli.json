        "html_id": "installation-and-getting-help",
        "implicit": true
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "value": "Visit https://qiime2.org to learn more about rachis-cli and the rachis project."
          }
        ]
      },
      {
        "type": "heading",
        "depth": 2,
        "children": [
          {
            "type": "text",
            "value": "Enabling tab completion"
          }
        ],
        "identifier": "enabling-tab-completion",
        "label": "Enabling tab completion",
        "html_id": "enabling-tab-completion",
        "implicit": true
      },
      {
        "type": "heading",
        "depth": 3,
        "children": [
          {
            "type": "text",
            "value": "Bash"
          }
        ],
        "identifier": "bash",
        "label": "Bash",
        "html_id": "bash",
        "implicit": true
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "value": "To enable tab completion in Bash, run the following command or add it to your\n"
          },
          {
            "type": "inlineCode",
            "value": ".bashrc"
          },
          {
            "type": "text",
            "value": "/"
          },
          {
            "type": "inlineCode",
            "value": ".bash_profile"
          },
          {
            "type": "text",
            "value": ":"
          }
        ]
      },
      {
        "type": "code",
        "lang": "bash",
        "value": "source tab-rachis"
      },
      {
        "type": "heading",
        "depth": 3,
        "children": [
          {
            "type": "text",
            "value": "ZSH"
          }
        ],
        "identifier": "zsh",
        "label": "ZSH",
        "html_id": "zsh",
        "implicit": true
      },
      {
        "type": "paragraph",
        "children": [
          {
            "type": "text",
            "value": "To enable tab completion in ZSH, run the following commands or add them to your\n"
          },
          {
            "type": "inlineCode",
            "value": ".zshrc"
          },
          {
            "type": "text",
            "value": ":"
          }
        ]
      },
      {
        "type": "code",
        "lang": "bash",
        "value": "autoload -Uz compinit && compinit && autoload bashcompinit && bashcompinit && source tab-rachis"
      }
    ]
  },
